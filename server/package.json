{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "prisma generate && prisma migrate deploy && node server.js",
    "dev": "dotenv -e .env.development -- prisma generate && dotenv -e .env.development -- nodemon server.js",
    "server": "nodemon server.js",
    "seed": "dotenv -e .env.development -- node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "migrate": "dotenv -e .env.development -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:studio": "dotenv -e .env.development -- prisma studio"
  },
  "prisma": {
    "seed": "dotenv -e .env.development -- node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "dotenv-cli": "11.0.0",
    "eslint": "10.2.0",
    "globals": "17.4.0",
    "nodemon": "3.1.10",
    "pino-pretty": "13.1.3",
    "prisma": "6.15.0",
    "supertest": "7.2.2",
    "vitest": "4.1.3"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.73.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "express-rate-limit": "8.3.2",
    "helmet": "8.1.0",
    "hpp": "0.2.3",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.0.2",
    "node-schedule": "2.1.1",
    "nodemailer": "7.0.9",
    "pdfkit": "0.18.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.3.6"
  },
  "volta": {
    "node": "22.19.0"
  }
}
