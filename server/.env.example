NODE_ENV=production
PORT=3000

# MySQL — Railway provides this automatically as DATABASE_URL
DATABASE_URL=mysql://user:password@host:3306/dbname

# JWT — use strong random strings (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (the Railway URL of your client service, comma-separated for multiple)
FRONTEND_URL=https://your-client.up.railway.app

# SMTP (optional — mail features disabled without these)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Finmo <no-reply@finmo.app>

# Redis (optional)
REDIS_URL=

BCRYPT_ROUNDS=12
